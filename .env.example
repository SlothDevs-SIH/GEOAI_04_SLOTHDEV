# Copy to .env (never commit .env). Leave empty if you do not use the feature.
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000

# API job storage and upload limit (api/main.py)
RUNS_DIR=./runs
MAX_UPLOAD_MB=200

# M8 radar flood mode (gated; see eval/README.md)
# Planetary Computer needs no key.
EARTHDATA_TOKEN=
GFM_TOKEN=
